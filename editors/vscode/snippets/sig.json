{
  "Pipeline header": {
    "prefix": "pipeline",
    "body": ["pipeline \"${1:name}\" v1", "", "$0"],
    "description": "File header: pipeline name and format version"
  },
  "Node": {
    "prefix": "node",
    "body": ["node ${1:id} = ${2:block}($3)"],
    "description": "Declare a node: id = block(parameters)"
  },
  "Probe": {
    "prefix": "probe",
    "body": ["probe ${1:node} as \"${2:name}\""],
    "description": "Watch a node output in the probe panel"
  },
  "Wire": {
    "prefix": "wire",
    "body": ["${1:from} -> ${2:to}"],
    "description": "Connect an output to an input (node.port for a named port)"
  },
  "Haar bank": {
    "prefix": "haarbank",
    "body": [
      "pipeline \"${1:haar_bank}\" v1",
      "",
      "node x   = samples(values=\"4 6 10 12 8 6 5 5\", rate=8)",
      "node h0  = convolve(filter=haar.h0, method=direct)",
      "node h1  = convolve(filter=haar.h1, method=direct)",
      "node a   = downsample(m=2, anti_alias=no, phase=1)",
      "node d   = downsample(m=2, anti_alias=no, phase=1)",
      "node ua  = upsample(m=2, anti_image=no)",
      "node ud  = upsample(m=2, anti_image=no)",
      "node f0  = convolve(filter=haar.f0, method=direct)",
      "node f1  = convolve(filter=haar.f1, method=direct)",
      "node sum = add()",
      "node pr  = check(kind=pr, tol=1e-12, delay=auto)",
      "",
      "x -> h0 -> a -> ua -> f0 -> sum.a",
      "x -> h1 -> d -> ud -> f1 -> sum.b",
      "x -> pr.ref",
      "sum -> pr.in",
      "probe a as \"a\"",
      "probe d as \"d\"",
      "probe sum as \"x̂\""
    ],
    "description": "One-level Haar analysis and synthesis bank with a reconstruction check"
  }
}
