{
  "name": "signals-sig",
  "displayName": "Signals .sig and .flt",
  "description": "Signals pipeline files (.sig) and filter files (.flt): highlighting, hovers, completion, checks and snippets",
  "version": "0.2.0",
  "publisher": "via-s-acc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VIA-s-acc/SignalProc"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:signals-sig",
    "onLanguage:signals-flt"
  ],
  "contributes": {
    "languages": [
      {
        "id": "signals-sig",
        "aliases": [
          "Signals pipeline",
          "sig"
        ],
        "extensions": [
          ".sig"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "signals-flt",
        "aliases": [
          "Signals filter",
          "flt"
        ],
        "extensions": [
          ".flt"
        ],
        "configuration": "./language-configuration-flt.json"
      }
    ],
    "grammars": [
      {
        "language": "signals-sig",
        "scopeName": "source.signals-sig",
        "path": "./syntaxes/sig.tmLanguage.json"
      },
      {
        "language": "signals-flt",
        "scopeName": "source.signals-flt",
        "path": "./syntaxes/flt.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "signals-sig",
        "path": "./snippets/sig.json"
      },
      {
        "language": "signals-flt",
        "path": "./snippets/flt.json"
      }
    ]
  }
}
