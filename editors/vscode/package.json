{
  "name": "signals-sig",
  "displayName": "Signals .sig and .flt",
  "description": "Signals pipeline files (.sig) and filter files (.flt): highlighting, hovers, completion, checks and snippets",
  "version": "0.6.0",
  "publisher": "via-s-acc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VIA-s-acc/SignalProc"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:signals-sig",
    "onLanguage:signals-flt",
    "onCommand:signals.preview"
  ],
  "contributes": {
    "languages": [
      {
        "id": "signals-sig",
        "aliases": [
          "Signals pipeline",
          "sig"
        ],
        "extensions": [
          ".sig"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "signals-flt",
        "aliases": [
          "Signals filter",
          "flt"
        ],
        "extensions": [
          ".flt"
        ],
        "configuration": "./language-configuration-flt.json"
      }
    ],
    "grammars": [
      {
        "language": "signals-sig",
        "scopeName": "source.signals-sig",
        "path": "./syntaxes/sig.tmLanguage.json"
      },
      {
        "language": "signals-flt",
        "scopeName": "source.signals-flt",
        "path": "./syntaxes/flt.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "signals-sig",
        "path": "./snippets/sig.json"
      },
      {
        "language": "signals-flt",
        "path": "./snippets/flt.json"
      }
    ],
    "commands": [
      {
        "command": "signals.preview",
        "title": "Signals: Preview",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "signals.preview",
          "when": "resourceLangId == signals-sig",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "signals.preview",
          "when": "editorLangId == signals-sig"
        }
      ]
    },
    "configuration": {
      "title": "Signals",
      "properties": {
        "signals.path": {
          "type": "string",
          "default": "signals",
          "description": "The signals program the preview runs: a name on PATH or a full path",
          "scope": "machine"
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted folder the preview does not run: a graph can write files.",
      "restrictedConfigurations": [
        "signals.path"
      ]
    }
  }
}
