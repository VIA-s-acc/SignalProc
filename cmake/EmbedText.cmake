function(signals_embed_text input output symbol)
  # A char array rather than a string literal: MSVC caps a single literal at about 16 KB (C2026).
  file(READ ${input} hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," bytes "${hex}")
  string(REPEAT "'[^']+'," 24 line)
  string(REGEX REPLACE "(${line})" "\\1\n" bytes "${bytes}")
  file(WRITE ${output} "extern const char ${symbol}[];\nconst char ${symbol}[] = {\n${bytes}'\\0'};\n")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${input})
endfunction()

function(signals_embed_dir dir pattern output symbol)
  file(GLOB files CONFIGURE_DEPENDS "${dir}/${pattern}")
  list(SORT files)
  set(body "#include <cstddef>\n\nstruct SignalsEmbeddedFile {\n  const char* name;\n  const char* text;\n};\n\n")
  set(entries "")
  set(index 0)
  string(REPEAT "'[^']+'," 24 line)
  foreach(file ${files})
    file(READ ${file} hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," bytes "${hex}")
    string(REGEX REPLACE "(${line})" "\\1\n" bytes "${bytes}")
    get_filename_component(name ${file} NAME)
    string(APPEND body "static const char ${symbol}_${index}[] = {\n${bytes}'\\0'};\n")
    string(APPEND entries "    {\"${name}\", ${symbol}_${index}},\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${file})
    math(EXPR index "${index} + 1")
  endforeach()
  string(APPEND body "\nextern const SignalsEmbeddedFile ${symbol}[];\nextern const std::size_t ${symbol}Count;\n")
  string(APPEND body "const SignalsEmbeddedFile ${symbol}[] = {\n${entries}    {nullptr, nullptr}};\nconst std::size_t ${symbol}Count = ${index};\n")
  file(WRITE ${output} "${body}")
endfunction()

# Embeds files that change with the code (C++ sources) at build time, so editing one does not re-run CMake.
function(signals_embed_files root files output symbol)
  set(deps "")
  foreach(file ${files})
    list(APPEND deps ${root}/${file})
  endforeach()
  string(REPLACE ";" "|" joined "${files}")
  add_custom_command(
    OUTPUT ${output}
    COMMAND ${CMAKE_COMMAND} -DROOT=${root} -DOUTPUT=${output} -DSYMBOL=${symbol} -DFILES=${joined} -P ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/EmbedFiles.cmake
    DEPENDS ${deps} ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/EmbedFiles.cmake
    VERBATIM)
endfunction()
