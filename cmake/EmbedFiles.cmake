# Run with cmake -P: ROOT, OUTPUT, SYMBOL and FILES (paths relative to ROOT, separated by "|").
cmake_minimum_required(VERSION 3.28)
string(REPLACE "|" ";" pending "${FILES}")
set(files "")
while(pending)
  list(POP_FRONT pending file)
  if(file IN_LIST files)
    continue()
  endif()
  list(APPEND files ${file})
  get_filename_component(dir ${file} DIRECTORY)
  file(STRINGS ${ROOT}/${file} includes REGEX "^[ \t]*#include \"[^\"]+\"")
  foreach(include_line ${includes})
    string(REGEX REPLACE "^[ \t]*#include \"([^\"]+)\".*" "\\1" header "${include_line}")
    if(EXISTS ${ROOT}/src/${header})
      list(APPEND pending src/${header})
    else()
      cmake_path(SET relative NORMALIZE "${dir}/${header}")
      if(EXISTS ${ROOT}/${relative})
        list(APPEND pending ${relative})
      endif()
    endif()
  endforeach()
endwhile()
list(SORT files)
set(body "#include <cstddef>\n\nstruct SignalsEmbeddedFile {\n  const char* name;\n  const char* text;\n};\n\n")
set(entries "")
set(index 0)
string(REPEAT "'[^']+'," 24 line)
foreach(file ${files})
  file(READ ${ROOT}/${file} hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," bytes "${hex}")
  string(REGEX REPLACE "(${line})" "\\1\n" bytes "${bytes}")
  string(APPEND body "static const char ${SYMBOL}_${index}[] = {\n${bytes}'\\0'};\n")
  string(APPEND entries "    {\"${file}\", ${SYMBOL}_${index}},\n")
  math(EXPR index "${index} + 1")
endforeach()
string(APPEND body "\nextern const SignalsEmbeddedFile ${SYMBOL}[];\nextern const std::size_t ${SYMBOL}Count;\n")
string(APPEND body "const SignalsEmbeddedFile ${SYMBOL}[] = {\n${entries}    {nullptr, nullptr}};\nconst std::size_t ${SYMBOL}Count = ${index};\n")
file(WRITE ${OUTPUT} "${body}")
